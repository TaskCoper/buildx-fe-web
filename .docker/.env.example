# Copy to .docker/.env.dev or .docker/.env.prod and fill in deployment values.
# These values are embedded at build time; changing them requires a new image.
BMT_API_ORIGIN=https://bmt-api.vnzdna.com
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_APP_NAME="BuildX AI"
NEXT_PUBLIC_APP_URL=https://frontend.example.com
NEXT_PUBLIC_USE_MOCK_AUTH=false
NEXT_PUBLIC_USE_MOCK_API=false
# GitHub Environment dev → Secret (không phải Variable) theo workflow hiện tại.
# Bật đủ bốn bước; backend cần Mode=Live và EnabledStages=Plan2d,Estimate,Render3d,Dossier.
# Thay giá trị cần build lại image. Khóa OpenAI/Anthropic chỉ đặt ở backend.
NEXT_PUBLIC_ESTIMATE_PIPELINE_ENABLED=true
NEXT_PUBLIC_VIETMAP_API_KEY=

# Server-only key: passed to the running container, never a Docker build arg.
VIETMAP_API_KEY=

# Server-only webhook key for POST /api/cms/revalidate, shared with the backend.
# Passed to the running container, never a Docker build arg or NEXT_PUBLIC_* variable.
CMS_REVALIDATION_SECRET=

# Deployment settings: dev=bmt-network-dev; prod=bmt-network-prod.
# sync-env-secrets.sh maps NETWORK to the GitHub Environment variable DOCKER_NETWORK.
NETWORK=bmt-network-dev

# Local Compose settings; not uploaded as GitHub secrets or variables.
REGISTRY=ghcr.io/taskcoper/buildx-fe-web
TAG=dev-latest
# For prod: BMT_API_ORIGIN=http://bmt-api-prod:8080, NETWORK=bmt-network-prod,
# NEXT_PUBLIC_APP_URL=https://thietkeai.com.vn, TAG=prod-latest.
