# Backend .NET. Next.js chuyển tiếp /api/v1/* tới địa chỉ này.
BMT_API_ORIGIN=https://bmt-api.vnzdna.com

# Giữ đường dẫn tương đối để đăng nhập bằng cookie qua proxy cùng domain.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_APP_NAME="BuildX AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# false: dùng backend thật; true: dùng mock phục vụ phát triển giao diện.
NEXT_PUBLIC_USE_MOCK_AUTH=false
NEXT_PUBLIC_USE_MOCK_API=false

# Tuỳ chọn: khoá công khai để hiển thị bản đồ trong trình duyệt.
NEXT_PUBLIC_VIETMAP_API_KEY=
# Tuỳ chọn: khoá riêng cho geocode trên máy chủ; không thêm NEXT_PUBLIC_.
VIETMAP_API_KEY=
