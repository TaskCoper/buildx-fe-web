# Backend .NET. Next.js chuyển tiếp /api/v1/* tới địa chỉ này.
BMT_API_ORIGIN=https://bmt-api.vnzdna.com

# Tuỳ chọn: BE gọi POST /api/cms/revalidate bằng Authorization: Bearer <secret>.
# Chỉ dùng trên server; admin gọi bằng cookie nên không cần khoá này.
CMS_REVALIDATION_SECRET=

# Giữ đường dẫn tương đối để đăng nhập bằng cookie qua proxy cùng domain.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_APP_NAME="BuildX AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# false: dùng backend thật; true: dùng mock phục vụ phát triển giao diện.
NEXT_PUBLIC_USE_MOCK_AUTH=false
NEXT_PUBLIC_USE_MOCK_API=false

# Mẫu dùng đủ bốn bước: 2D → Dự toán → 3D → Hồ sơ; backend phải bật cùng luồng.
# GitHub Environment dev → Secret NEXT_PUBLIC_ESTIMATE_PIPELINE_ENABLED=true (theo workflow hiện tại).
# Cờ NEXT_PUBLIC_* được chốt lúc build; thay giá trị phải build lại frontend.
# Khi deploy, đổi BMT_API_ORIGIN và NEXT_PUBLIC_APP_URL ở trên sang địa chỉ Dev.
# Khóa OpenAI/Anthropic chỉ cấu hình ở backend.
NEXT_PUBLIC_ESTIMATE_PIPELINE_ENABLED=true

# Tuỳ chọn: khoá công khai để hiển thị bản đồ trong trình duyệt.
NEXT_PUBLIC_VIETMAP_API_KEY=
# Tuỳ chọn: khoá riêng cho geocode trên máy chủ; không thêm NEXT_PUBLIC_.
VIETMAP_API_KEY=
